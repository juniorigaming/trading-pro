# Conexão com o banco de dados PostgreSQL.
# Na Cloudflare Workers o driver fala via WebSocket, então recomendo o Neon (https://neon.tech)
# ou qualquer Postgres com suporte a WebSocket. Localmente (Node) a mesma URL funciona.
#
# Copie este arquivo para .env e preencha com sua URL real.
# Nunca commite o arquivo .env (ele já está no .gitignore).
DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"

# ---------------------------------------------------------------------------
# Módulo de IA (somente backend — nunca expor no cliente / NEXT_PUBLIC_*)
# ---------------------------------------------------------------------------
# Provedor: openai (padrão) | gemini (free tier) | mock (testes/sem chave)
AI_PROVIDER="openai"
OPENAI_API_KEY="sk-..."
OPENAI_MODEL="gpt-4.1-mini"
# Opcional: alternativa gratuita (Google AI Studio)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
# Opcional: token simples para proteger rotas /api/ai/* (header x-app-token). Vazio = sem proteção.
APP_API_TOKEN=""
