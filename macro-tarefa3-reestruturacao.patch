+/** Enum de confiança derivado do percentual (mantido para compatibilidade com o schema/banco). */
+export function confidenceEnum(pct: number): Confidence {
+  if (pct >= 65) return "HIGH";
+  if (pct >= 40) return "MEDIUM";
   return "LOW";
